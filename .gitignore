# ---------------------------------------------------------------------------
# Secrets and credentials
# Nothing in this repo should ever contain live AWS credentials. Students work
# in temporary AWS accounts and may fork this repo; these patterns keep keys
# out of version control.
# ---------------------------------------------------------------------------

# setup_aws.py writes the real .env here. Everything else under .env.* is a
# local variant; .env.example is the tracked template and is exempted below.
.env
.env.*
!.env.example

# AWS CLI profiles and console credential downloads.
credentials
.aws/
*credentials*.csv
*accessKeys.csv

*.pem
*.key
.streamlit/secrets.toml

# ---------------------------------------------------------------------------
# macOS
# ---------------------------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes

# ---------------------------------------------------------------------------
# Microsoft Office lock/temp files
# Word and Excel create these whenever a .docx/.xlsx is open. This repo ships
# templates and knowledge-base documents in both formats, so these show up
# constantly during authoring.
# ---------------------------------------------------------------------------
~$*.docx
~$*.doc
~$*.xlsx
~$*.xls
~$*.pptx
~$*.ppt

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# ---------------------------------------------------------------------------
# Editors and IDEs
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# Logs and local scratch
# ---------------------------------------------------------------------------
*.log
.cache/
tmp/
